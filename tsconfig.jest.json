{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    "module": "CommonJS",
    "moduleResolution": "Node",

    "jsx": "react-jsx",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "noEmit": true,

    "types": [
      "jest",
      "@testing-library/jest-dom"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}